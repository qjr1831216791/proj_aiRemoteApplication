# 环境变量模板
# 用法：复制为同目录下的 .env 并填入真实值（.env 已被 .gitignore 忽略，禁止提交）。
# 新增变量必须同步登记到这里，并注明用途。

# ---- 通用 ----
APP_ENV=development          # development | test | production
LOG_LEVEL=info               # debug | info | warn | error

# ---- 外部服务（按实际功能启用，示例见下）----
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379/0
# LLM_API_KEY=               # AI 服务密钥，真实值只放 .env 或部署平台

# ---- CloudCLI HTTPS 栈（腾讯云 CAM 凭证，供 ddns-go / acme.sh 做 DDNS 与 DNS-01 签证书）----
# 创建入口：https://console.cloud.tencent.com/cam/capi （API 密钥管理 → 新建密钥）
# 安全建议：规范做法是建子用户并只授予 DNSPod/DNS 写权限，再为其创建密钥
TENCENT_SECRET_ID=           # 腾讯云 API SecretId
TENCENT_SECRET_KEY=          # 腾讯云 API SecretKey

# ---- SakuraFrp 穿透（spec 004：隧道客户端 frpc 的登录凭证，工作台读它拼装启动参数）----
# 创建入口：https://www.natfrp.com/user/ （用户中心 → 查看访问密钥）
# 注意：这是客户端专用密码，与账户登录密码不同；泄露后在用户信息页重置
# spec 007：远程访问默认改组网通道（EasyTier），穿透通道可经设置页显式停用；
# 停用后本密钥已无用，可运行 clear-frp-key.ps1 从栈 .env 清除该行（设置页有入口）
SAKURA_FRP_KEY=              # SakuraFrp 访问密钥（Token；组网通道下停用穿透后可清除）
